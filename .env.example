# Database connection URL for PostgreSQL with PostGIS
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Ensure PostGIS extension is available on your PostgreSQL instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/africa_health_facilities?schema=public"

# JWT Secret for authentication
JWT_SECRET="your-jwt-secret-here"

# Server configuration
PORT=3000
NODE_ENV=development
